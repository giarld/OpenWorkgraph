{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenWorkgraph skill configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "environment"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "environment": {
      "type": "array",
      "items": {"$ref": "#/$defs/environmentVariable"}
    }
  },
  "$defs": {
    "nonBlankText": {"type": "string", "pattern": "\\S"},
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description"],
      "properties": {
        "label": {"$ref": "#/$defs/nonBlankText"},
        "description": {"$ref": "#/$defs/nonBlankText"}
      }
    },
    "environmentVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "description", "required", "secret"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": {"pattern": "\\s"}},
        "label": {"$ref": "#/$defs/nonBlankText"},
        "description": {"$ref": "#/$defs/nonBlankText"},
        "required": {"type": "boolean"},
        "secret": {"type": "boolean"},
        "default": {"type": "string"},
        "translations": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "not": {"pattern": "\\s"}},
          "additionalProperties": {"$ref": "#/$defs/translation"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"secret": {"const": true}}, "required": ["secret"]},
          "then": {"not": {"required": ["default"]}}
        }
      ]
    }
  }
}
