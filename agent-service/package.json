{
  "name": "openworkgraph",
  "version": "0.7.3",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "openworkgraph": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "README.zh-CN.md",
    "assets/readme/",
    "assets/skill-creator/"
  ],
  "scripts": {
    "prebuild": "node ../scripts/check-versions.mjs --quiet",
    "build": "tsc -p tsconfig.json && node scripts/vendor-protocol.mjs && node scripts/build-visualize-preview.mjs",
    "prepack": "node scripts/prepare-pack.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/open-responses": "2.0.77",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/openai-compatible": "3.0.82",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@winlinux/auth": "1.1.0",
    "@winlinux/smb2": "1.1.0",
    "ai": "7.0.159",
    "basic-ftp": "6.2.4",
    "cross-spawn": "7.0.6",
    "iconv-lite": "0.7.3",
    "sharp": "^0.35.4",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.6",
    "esbuild": "0.28.2"
  }
}
