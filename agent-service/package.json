{
  "name": "openworkgraph",
  "version": "0.5.8",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "openworkgraph": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "README.en.md",
    "assets/readme/"
  ],
  "scripts": {
    "prebuild": "node ../scripts/check-versions.mjs --quiet",
    "build": "tsc -p tsconfig.json && node scripts/vendor-protocol.mjs && node scripts/build-visualize-preview.mjs",
    "prepack": "node scripts/prepare-pack.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "sharp": "^0.35.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
